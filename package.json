{
	"name": "fitcode",
	"displayName": "FitCode",
	"description": "%fitcode.description%",
	"version": "0.3.0",
	"publisher": "local",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"ui"
	],
	"categories": [
		"Other"
	],
	"main": "./src/extension.js",
	"l10n": "./l10n",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"configuration": {
			"title": "FitCode",
			"properties": {
				"fitcode.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%fitcode.config.enabled.description%"
				},
				"fitcode.center": {
					"type": "boolean",
					"default": true,
					"description": "%fitcode.config.center.description%"
				},
				"fitcode.minTextWidth": {
					"type": "number",
					"default": 640,
					"minimum": 0,
					"maximum": 4000,
					"description": "%fitcode.config.minTextWidth.description%"
				},
				"fitcode.paddingRight": {
					"type": "number",
					"default": 20,
					"minimum": 0,
					"maximum": 400,
					"description": "%fitcode.config.paddingRight.description%"
				},
				"fitcode.animate": {
					"type": "boolean",
					"default": true,
					"description": "%fitcode.config.animate.description%"
				},
				"fitcode.animateDuration": {
					"type": "number",
					"default": 140,
					"minimum": 0,
					"maximum": 1000,
					"description": "%fitcode.config.animateDuration.description%"
				},
				"fitcode.lineNumbersOnlyAtCursor": {
					"type": "boolean",
					"default": true,
					"description": "%fitcode.config.lineNumbersOnlyAtCursor.description%"
				},
				"fitcode.cacheSize": {
					"type": "number",
					"default": 300,
					"minimum": 10,
					"maximum": 5000,
					"description": "%fitcode.config.cacheSize.description%"
				}
			}
		},
		"commands": [
			{
				"command": "fitcode.enable",
				"title": "%fitcode.command.enable.title%"
			},
			{
				"command": "fitcode.disable",
				"title": "%fitcode.command.disable.title%"
			},
			{
				"command": "fitcode.status",
				"title": "%fitcode.command.status.title%"
			}
		]
	}
}
