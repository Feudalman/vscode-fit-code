{
	"name": "fitcode",
	"displayName": "FitCode",
	"description": "让编辑器正文像 JetBrains 那样居中：宽度 = 当前文件最长一行的宽度",
	"version": "0.3.0",
	"publisher": "local",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"ui"
	],
	"categories": [
		"Other"
	],
	"main": "./src/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"configuration": {
			"title": "FitCode",
			"properties": {
				"fitcode.enabled": {
					"type": "boolean",
					"default": false,
					"description": "FitCode 是否已写入 VSCode 安装目录。由「启用/禁用」命令自动维护，勿手改。"
				},
				"fitcode.center": {
					"type": "boolean",
					"default": true,
					"description": "正文居中。关闭即回归原生布局（1~2 秒内生效，无需重载窗口）。"
				},
				"fitcode.minTextWidth": {
					"type": "number",
					"default": 640,
					"minimum": 0,
					"maximum": 4000,
					"description": "正文最小宽度（像素）。"
				},
				"fitcode.paddingRight": {
					"type": "number",
					"default": 20,
					"minimum": 0,
					"maximum": 400,
					"description": "正文右侧额外留白（像素）。"
				},
				"fitcode.animate": {
					"type": "boolean",
					"default": true,
					"description": "切换文件/内容变化时宽度渐变。"
				},
				"fitcode.animateDuration": {
					"type": "number",
					"default": 140,
					"minimum": 0,
					"maximum": 1000,
					"description": "宽度渐变时长（毫秒），0 表示不渐变。"
				},
				"fitcode.lineNumbersOnlyAtCursor": {
					"type": "boolean",
					"default": true,
					"description": "行号只显示光标所在行（多光标则每处都显示）。关闭即恢复原生行号。"
				},
				"fitcode.cacheSize": {
					"type": "number",
					"default": 300,
					"minimum": 10,
					"maximum": 5000,
					"description": "每文件宽度缓存的条数上限。"
				}
			}
		},
		"commands": [
			{
				"command": "fitcode.enable",
				"title": "FitCode: 启用（写入 VSCode 安装目录）"
			},
			{
				"command": "fitcode.disable",
				"title": "FitCode: 禁用（还原安装目录）"
			},
			{
				"command": "fitcode.status",
				"title": "FitCode: 显示状态"
			}
		]
	}
}
